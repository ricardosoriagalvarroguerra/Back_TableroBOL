# Copiar a .env y ajustar.
# Conexión a la BDR PostgreSQL local (Postgres.app).
DATABASE_URL=postgres://ricardosoriagalvarro@localhost:5432/bolivia

# Servidor
PORT=5174
HOST=0.0.0.0

# CORS — origen del frontend Vite (true = refleja cualquier origen, sólo dev)
CORS_ORIGIN=http://localhost:5180

# Auto-aprovisionamiento de la BDR al arrancar (schema + seed si cambió el hash)
# DB_AUTO_SEED=false

# Ingesta automática de fuentes (BCB TCO, FMI WEO): al arrancar y cada N horas
# INGEST_ENABLED=false
# INGEST_INTERVAL_HOURS=6
# Token para POST /api/ingesta (sin token, el endpoint responde 401)
# INGEST_TOKEN=
